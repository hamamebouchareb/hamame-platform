# Copy this file to .env and fill in real values before running Prisma commands.

# PostgreSQL connection string used by Prisma (prisma/schema.prisma datasource "db").
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hamame?schema=public"

# Express server port.
PORT=3000

# Comma-separated list of allowed browser origins for the API (e.g.
# "https://hamame.dz,https://www.hamame.dz"). Defaults to
# http://localhost:3001 (the local frontend dev server) when unset.
# CORS_ORIGIN is still honored as a legacy fallback if ALLOWED_ORIGINS is unset.
ALLOWED_ORIGINS=http://localhost:3001

# Secret used to sign/verify auth JWTs (see src/middleware/auth.ts). Use a long, random,
# secret-manager-issued value in any non-local environment.
JWT_SECRET="replace-with-a-long-random-secret"

# Anthropic API key, shared by every AI feature: per-option MCQ explanations
# (src/lib/ai/mcq-explanation.ts) and contextual hints
# (src/lib/ai/contextual-hint.ts). Optional: when unset, the on-approval hook in
# review.routes.ts logs and skips, the backfill script exits with an error, and
# POST /api/sessions/:id/hints returns 503 AI_NOT_CONFIGURED without spending a credit.
ANTHROPIC_API_KEY=""

# Native Web Push (VAPID) — no third-party provider (no OneSignal etc.). Generate a
# keypair with `npx web-push generate-vapid-keys`. Optional: when unset, push sends log
# their payload instead of calling the Push API (see src/lib/push/vapid.ts), so the
# server and all three notification triggers still run in dev without real keys.
# VAPID_SUBJECT must be a "mailto:" or "https:" URL identifying the sender, per the spec.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@hamame.dz"
