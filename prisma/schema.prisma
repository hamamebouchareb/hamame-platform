// ---------------------------------------------------------------------------
// 10. Push notifications (native Web Push / VAPID — no third-party provider)
// ---------------------------------------------------------------------------

// One row per subscribed browser/device (a student can have several: phone, laptop,
// a second browser, etc.) — NOT one row per user. `endpoint` is the Push API's own
// per-installation URL, guaranteed unique per browser+origin+service-worker
// registration, so it is the natural dedupe key: re-subscribing the same
// device/browser (permission re-granted, two tabs both calling subscribe on load)
// returns the SAME endpoint, and src/routes/push.routes.ts upserts on it via
// `INSERT ... ON CONFLICT (endpoint) DO UPDATE` (never a caught P2002) — the same
// idempotency idiom already used for UserBadge/ReviewQueueItem — instead of a
// composite (user_id, endpoint) key, which would still allow duplicate rows (and
// duplicate sends to the same physical device) if the same device were queried
// under two different user ids over time (e.g. a shared/lab computer).
model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String   @unique @db.Text
  p256dhKey  String   @map("p256dh_key")
  authKey    String   @map("auth_key")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @updatedAt @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// One row per user (not per subscription), single-table 4-boolean shape rather than
// reusing NotificationPreference's (user_id, category, channel) taxonomy — that table's
// 5 categories (revision/subscription/content_update/moderation/social) don't map
// cleanly onto these 3 push-specific types (badgeEarned in particular isn't any of
// them), and it has no room for a master switch. No row for a user = all four default
// true, same "missing row -> default" convention already used by Streak/ReviewSettings
// (see src/lib/daily-goal.ts, src/routes/streaks.routes.ts).
model PushPreference {
  userId            String  @id @map("user_id") @db.Uuid
  masterEnabled     Boolean @default(true) @map("master_enabled")
  dailyGoalReminder Boolean @default(true) @map("daily_goal_reminder")
  streakAtRisk      Boolean @default(true) @map("streak_at_risk")
  badgeEarned       Boolean @default(true) @map("badge_earned")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_preferences")
}
