{
  "name": "hamame",
  "version": "0.1.0",
  "private": true,
  "description": "Hamame — Algerian digital learning platform. Backend API and database schema.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio",
    "ai:backfill-explanations": "tsx src/scripts/backfill-mcq-explanations.ts",
    "verify:hints": "tsx src/scripts/verify-contextual-hints.ts",
    "verify:hints:ai": "tsx src/scripts/verify-contextual-hints.ts --ai",
    "verify:push": "tsx src/scripts/verify-push-notifications.ts",
    "verify:readiness": "tsx src/scripts/verify-exam-readiness.ts",
    "verify:credits": "tsx src/scripts/verify-ai-credits.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
